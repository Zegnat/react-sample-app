# syntax=docker/dockerfile:1
# CI-only image: static-web-server serving a pre-built `dist/`. CI builds the
# Preact production bundle once (in the `build` job) and copies it in here, so
# this image needs no Node toolchain and no `npm ci`. The full-build local image
# lives in `Dockerfile` (used by `npm run test:e2e:docker`); both are re-pinned
# by `upgrade-images.mjs`.
FROM ghcr.io/static-web-server/static-web-server:2.44.1@sha256:94618e3d17802265a21926217e6f9e7832b311b6fbf5933684001739fafed06a AS final
COPY ["dist", "/public"]
USER 65532:65532
